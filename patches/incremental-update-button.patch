diff --git a/qce-v4-tool/lib/incremental-sync.ts b/qce-v4-tool/lib/incremental-sync.ts
new file mode 100644
index 0000000..08f82f8
--- /dev/null
+++ b/qce-v4-tool/lib/incremental-sync.ts
@@ -0,0 +1,211 @@
+/**
+ * QCE-CUSTOM-ADDON：增量更新的"历史补同步"检测。
+ *
+ * 背景：QQ 的消息是懒同步的。电脑端可能今天才把前几天的消息补下来，这些消息
+ * 的 msgTime 是原本的发送时间，会"插"在历史位置。只按"上次导出的最后一条消息
+ * 往后拉"的增量策略会完全错过它们。
+ *
+ * 这里的做法：把已导出文件里"每天有多少条"和本地数据库里"每天实际多少条"
+ * 做对比，找出变多了的日期。
+ *
+ * 性能：跨度几个月的会话逐天查会产生上百次请求，所以用两层查询——先按月粗查，
+ * 只有数量对不上的月份才展开到天。典型情况（只有最近几天变动）能把请求数从
+ * 上百次降到几十次。
+ *
+ * 限制：只支持 JSON 格式的导出文件。HTML 导出没法可靠地把消息逐条抠出来。
+ */
+
+/** 导出文件里的一条消息（只取我们关心的字段）。 */
+interface ExportedMessage {
+  id?: string
+  timestamp?: number
+}
+
+export interface ExportedFileRef {
+  fileName: string
+  chatType?: string
+  chatId?: string
+}
+
+/** 某一天的差异。 */
+export interface DayGap {
+  /** YYYY-MM-DD（本地时区） */
+  day: string
+  /** 已导出文件里这天的条数 */
+  exported: number
+  /** 本地数据库里这天实际的条数 */
+  actual: number
+}
+
+export interface SyncPlan {
+  /** 历史上"变多了"的日期，需要补导 */
+  gaps: DayGap[]
+  /** 已导出内容覆盖到的最后一条消息时间（毫秒），没有已导出内容时为 undefined */
+  coveredUntil?: number
+  /** 参与统计的导出文件 */
+  scannedFiles: string[]
+  /** 实际发出的查询次数，用于向用户交代耗时来源 */
+  queryCount: number
+  /** 没有可用 JSON 导出时为 true——此时只能退回"从上次往后"的朴素增量 */
+  noJsonBaseline: boolean
+}
+
+/** 本地时区的 YYYY-MM-DD。 */
+export function toDayKey(ms: number): string {
+  const d = new Date(ms)
+  const p = (n: number) => String(n).padStart(2, '0')
+  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`
+}
+
+/** 本地时区的 YYYY-MM。 */
+export function toMonthKey(ms: number): string {
+  const d = new Date(ms)
+  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`
+}
+
+/** 某天的 [起, 止) 毫秒区间（本地时区）。 */
+export function dayRange(day: string): [number, number] {
+  const [y, m, d] = day.split('-').map(Number)
+  const start = new Date(y, m - 1, d, 0, 0, 0, 0).getTime()
+  const end = new Date(y, m - 1, d + 1, 0, 0, 0, 0).getTime()
+  return [start, end]
+}
+
+/** 某月的 [起, 止) 毫秒区间（本地时区）。 */
+export function monthRange(month: string): [number, number] {
+  const [y, m] = month.split('-').map(Number)
+  const start = new Date(y, m - 1, 1, 0, 0, 0, 0).getTime()
+  const end = new Date(y, m, 1, 0, 0, 0, 0).getTime()
+  return [start, end]
+}
+
+/** 列出某月里已经开始了的日期（不含未来）。 */
+function daysInMonth(month: string, notAfter: number): string[] {
+  const [y, m] = month.split('-').map(Number)
+  const out: string[] = []
+  for (let d = 1; d <= 31; d++) {
+    const t = new Date(y, m - 1, d, 0, 0, 0, 0)
+    if (t.getMonth() !== m - 1) break // 跨月了
+    if (t.getTime() > notAfter) break
+    out.push(toDayKey(t.getTime()))
+  }
+  return out
+}
+
+/**
+ * 统计已导出 JSON 里每天的消息条数。
+ * 同一条消息可能出现在多个导出文件里（比如重叠区间），按 msgId 去重，
+ * 和官方合并的去重口径保持一致。
+ */
+export function tallyExported(
+  files: Array<{ fileName: string; messages: ExportedMessage[] }>,
+): { byDay: Map<string, number>; coveredUntil?: number; seenIds: Set<string> } {
+  const byDay = new Map<string, number>()
+  const seenIds = new Set<string>()
+  let coveredUntil: number | undefined
+
+  for (const f of files) {
+    for (const m of f.messages) {
+      const ts = Number(m.timestamp)
+      if (!Number.isFinite(ts) || ts <= 0) continue
+      const id = m.id ? String(m.id) : `${ts}`
+      if (seenIds.has(id)) continue
+      seenIds.add(id)
+      const day = toDayKey(ts)
+      byDay.set(day, (byDay.get(day) || 0) + 1)
+      if (coveredUntil === undefined || ts > coveredUntil) coveredUntil = ts
+    }
+  }
+  return { byDay, coveredUntil, seenIds }
+}
+
+/**
+ * 两层比对：先按月，再对有差异的月份展开到天。
+ *
+ * @param countInRange 查询本地某时间区间内的消息条数
+ */
+export async function planIncrementalSync(opts: {
+  exported: Array<{ fileName: string; messages: ExportedMessage[] }>
+  countInRange: (startMs: number, endMs: number) => Promise<number>
+  /** 只检查这个时间点之前的历史，默认现在 */
+  now?: number
+  /** 最多回溯多少天（默认 400 天，避免超长会话打太多请求） */
+  maxLookbackDays?: number
+}): Promise<SyncPlan> {
+  const now = opts.now ?? Date.now()
+  const maxLookback = (opts.maxLookbackDays ?? 400) * 86_400_000
+
+  if (!opts.exported.length) {
+    return { gaps: [], scannedFiles: [], queryCount: 0, noJsonBaseline: true }
+  }
+
+  const { byDay, coveredUntil } = tallyExported(opts.exported)
+  const scannedFiles = opts.exported.map((f) => f.fileName)
+  let queryCount = 0
+
+  if (!byDay.size || coveredUntil === undefined) {
+    return { gaps: [], coveredUntil, scannedFiles, queryCount, noJsonBaseline: false }
+  }
+
+  // 已导出内容覆盖的月份集合（只在这些月份里找"变多了"的天；
+  // 完全没导出过的历史月份不属于"补同步"，属于用户自己没导，不在这里管）
+  const months = new Set<string>()
+  const earliestAllowed = now - maxLookback
+  for (const day of byDay.keys()) {
+    const [start] = dayRange(day)
+    if (start < earliestAllowed) continue
+    months.add(day.slice(0, 7))
+  }
+
+  const gaps: DayGap[] = []
+  for (const month of Array.from(months).sort()) {
+    const [ms, me] = monthRange(month)
+    const monthEnd = Math.min(me, now)
+    if (monthEnd <= ms) continue
+
+    // 该月已导出的条数
+    let exportedInMonth = 0
+    for (const [day, n] of byDay) {
+      if (day.startsWith(month)) exportedInMonth += n
+    }
+
+    const actualInMonth = await opts.countInRange(ms, monthEnd)
+    queryCount++
+    // 只关心"本地比导出多"。少的情况通常是导出时用了过滤条件，不该当成缺口。
+    if (actualInMonth <= exportedInMonth) continue
+
+    // 该月有差异 → 展开到天
+    for (const day of daysInMonth(month, now)) {
+      const [ds, de] = dayRange(day)
+      if (ds < earliestAllowed) continue
+      const exported = byDay.get(day) || 0
+      const actual = await opts.countInRange(ds, Math.min(de, now))
+      queryCount++
+      if (actual > exported) gaps.push({ day, exported, actual })
+    }
+  }
+
+  return { gaps, coveredUntil, scannedFiles, queryCount, noJsonBaseline: false }
+}
+
+/** 把相邻的缺口日期合并成连续区间，减少导出任务数。 */
+export function mergeAdjacentDays(days: string[]): Array<{ start: string; end: string }> {
+  if (!days.length) return []
+  const sorted = [...days].sort()
+  const out: Array<{ start: string; end: string }> = []
+  let start = sorted[0]
+  let prev = sorted[0]
+  for (const day of sorted.slice(1)) {
+    const [prevStart] = dayRange(prev)
+    const [curStart] = dayRange(day)
+    if (curStart - prevStart <= 86_400_000) {
+      prev = day
+      continue
+    }
+    out.push({ start, end: prev })
+    start = day
+    prev = day
+  }
+  out.push({ start, end: prev })
+  return out
+}
