+      endTime: new Date().toISOString(),
+      includeRecalled: false,
+      includeSystemMessages: true,
+      filterPureImageMessages: false,
+    })
+    if (success) {
+      tasksLoadedRef.current = false
+    }
+  }, [createTask, friends])
