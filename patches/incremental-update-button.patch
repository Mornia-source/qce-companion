new file mode 100644
index 0000000..65c4b8f
--- /dev/null
+++ b/qce-v4-tool/lib/incremental-sync.ts
@@ -0,0 +1,350 @@
+/**
+ * QCE-CUSTOM-ADDON：增量更新的"历史补同步"检测。
+ *
+ * 背景：QQ 的消息是懒同步的。电脑端可能今天才把前几天的消息补下来，这些消息
+ * 的 msgTime 是原本的发送时间，会"插"在历史位置。只按"上次导出的最后一条消息
+ * 往后拉"的增量策略会完全错过它们。
+ *
+ * 这里的做法：把已导出文件里"每天有多少条"和本地数据库里"每天实际多少条"
+ * 做对比，找出变多了的日期。
+ *
+ * 性能：跨度几个月的会话逐天查会产生上百次请求，所以用两层查询——先按月粗查，
+ * 只有数量对不上的月份才展开到天。典型情况（只有最近几天变动）能把请求数从
+ * 上百次降到几十次。
+ *
+ * 支持 JSON 和 HTML 两种导出做基线。HTML 用的是官方 chunked 模式，消息以
+ * `__QCE_CHUNK__({id:"c000001",messages:[{"id":..,"ts":..},...]})` 的形式内嵌在
+ * 页面里供前端渲染，逐条解析出 id / ts 完全可行。
+ */
+
+/** 导出文件里的一条消息（只取我们关心的字段）。 */
+interface ExportedMessage {
+  id?: string
+  timestamp?: number
+}
+
+export interface ExportedFileRef {
+  fileName: string
+  chatType?: string
+  chatId?: string
+}
+
+/** 某一天的差异。 */
+export interface DayGap {
+  /** YYYY-MM-DD（本地时区） */
+  day: string
+  /** 已导出文件里这天的条数 */
+  exported: number
+  /** 本地数据库里这天实际的条数 */
+  actual: number
+}
+
+export interface SyncPlan {
+  /** 历史上"变多了"的日期，需要补导 */
+  gaps: DayGap[]
+  /** 已导出内容覆盖到的最后一条消息时间（毫秒），没有已导出内容时为 undefined */
+  coveredUntil?: number
+  /** 参与统计的导出文件 */
+  scannedFiles: string[]
+  /** 实际发出的查询次数，用于向用户交代耗时来源 */
+  queryCount: number
+  /** 没有可用 JSON 导出时为 true——此时只能退回"从上次往后"的朴素增量 */
+  noJsonBaseline: boolean
+}
+
+/**
+ * 从导出文件的原始内容里提取消息（只要 id 和时间戳）。
+ *
+ * - `.json`：直接取 `messages[]` 的 `id` / `timestamp`
+ * - `.html`：官方 chunked 导出会把消息内嵌成
+ *   `__QCE_CHUNK__({id:"c000001",messages:[{"id":"msg-xxx","ts":1775134902000,...}]})`，
+ *   逐个 chunk 抠出 messages 数组解析即可。这里不用正则去匹配整个数组（消息里
+ *   带着渲染好的 HTML，嵌套引号和括号会让正则失效），而是从 `messages:[` 往后
+ *   做括号配对扫描，稳妥地取出完整的 JSON 数组。
+ */
+export function extractMessagesFromExport(
+  fileName: string,
+  raw: string,
+): ExportedMessage[] {
+  const lower = fileName.toLowerCase()
+
+  if (lower.endsWith('.json')) {
+    try {
+      const data = JSON.parse(raw)
+      return Array.isArray(data?.messages) ? data.messages : []
+    } catch {
+      return []
+    }
+  }
+
+  if (!lower.endsWith('.html') && !lower.endsWith('.htm')) return []
+
+  const out: ExportedMessage[] = []
+  const marker = 'messages:['
+  let cursor = 0
+  while (true) {
+    const at = raw.indexOf(marker, cursor)
+    if (at === -1) break
+    const arrStart = at + marker.length - 1 // 指向 '['
+    const arrEnd = matchBracket(raw, arrStart)
+    cursor = arrEnd === -1 ? at + marker.length : arrEnd + 1
+    if (arrEnd === -1) continue
+    try {
+      const arr = JSON.parse(raw.slice(arrStart, arrEnd + 1))
+      if (!Array.isArray(arr)) continue
+      for (const m of arr) {
+        // chunked HTML 用 ts，JSON 用 timestamp
+        const ts = Number(m?.ts ?? m?.timestamp)
+        if (!Number.isFinite(ts)) continue
+        out.push({ id: m?.id ? String(m.id) : undefined, timestamp: ts })
+      }
+    } catch {
+      // 该 chunk 解析失败就跳过，其它 chunk 不受影响
+    }
+  }
+  return out
+}
+
+/**
+ * 从 `open` 位置的 `[` 开始做括号配对，返回配对的 `]` 下标；找不到返回 -1。
+ * 会跳过字符串字面量（含转义），避免消息正文里的括号干扰。
+ */
+function matchBracket(s: string, open: number): number {
+  let depth = 0
+  let inStr = false
+  let quote = ''
+  for (let i = open; i < s.length; i++) {
+    const c = s[i]
+    if (inStr) {
+      if (c === '\\') { i++; continue }
+      if (c === quote) inStr = false
+      continue
+    }
+    if (c === '"' || c === "'") { inStr = true; quote = c; continue }
+    if (c === '[' || c === '{') depth++
+    else if (c === ']' || c === '}') {
+      depth--
+      if (depth === 0) return i
+    }
+  }
+  return -1
+}
+
+/** 本地时区的 YYYY-MM-DD。 */
+export function toDayKey(ms: number): string {
+  const d = new Date(ms)
+  const p = (n: number) => String(n).padStart(2, '0')
+  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`
+}
+
+/** 本地时区的 YYYY-MM。 */
+export function toMonthKey(ms: number): string {
+  const d = new Date(ms)
+  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`
+}
+
+/** 某天的 [起, 止) 毫秒区间（本地时区）。 */
+export function dayRange(day: string): [number, number] {
+  const [y, m, d] = day.split('-').map(Number)
+  const start = new Date(y, m - 1, d, 0, 0, 0, 0).getTime()
+  const end = new Date(y, m - 1, d + 1, 0, 0, 0, 0).getTime()
+  return [start, end]
+}
+
+/** 某月的 [起, 止) 毫秒区间（本地时区）。 */
+export function monthRange(month: string): [number, number] {
+  const [y, m] = month.split('-').map(Number)
+  const start = new Date(y, m - 1, 1, 0, 0, 0, 0).getTime()
+  const end = new Date(y, m, 1, 0, 0, 0, 0).getTime()
+  return [start, end]
+}
+
+/** 列出某月里已经开始了的日期（不含未来）。 */
+function daysInMonth(month: string, notAfter: number): string[] {
+  const [y, m] = month.split('-').map(Number)
+  const out: string[] = []
+  for (let d = 1; d <= 31; d++) {
+    const t = new Date(y, m - 1, d, 0, 0, 0, 0)
+    if (t.getMonth() !== m - 1) break // 跨月了
+    if (t.getTime() > notAfter) break
+    out.push(toDayKey(t.getTime()))
+  }
+  return out
+}
+
+/**
+ * 统计已导出 JSON 里每天的消息条数。
+ * 同一条消息可能出现在多个导出文件里（比如重叠区间），按 msgId 去重，
+ * 和官方合并的去重口径保持一致。
+ */
+export function tallyExported(
+  files: Array<{ fileName: string; messages: ExportedMessage[] }>,
+): { byDay: Map<string, number>; coveredUntil?: number; seenIds: Set<string> } {
+  const byDay = new Map<string, number>()
+  const seenIds = new Set<string>()
+  let coveredUntil: number | undefined
+
+  for (const f of files) {
+    for (const m of f.messages) {
+      const ts = Number(m.timestamp)
+      if (!Number.isFinite(ts) || ts <= 0) continue
+      const id = m.id ? String(m.id) : `${ts}`
+      if (seenIds.has(id)) continue
+      seenIds.add(id)
+      const day = toDayKey(ts)
+      byDay.set(day, (byDay.get(day) || 0) + 1)
+      if (coveredUntil === undefined || ts > coveredUntil) coveredUntil = ts
+    }
+  }
+  return { byDay, coveredUntil, seenIds }
+}
+
+/**
+ * 两层比对：先按月，再对有差异的月份展开到天。
+ *
+ * @param countInRange 查询本地某时间区间内的消息条数
+ */
+export async function planIncrementalSync(opts: {
+  exported: Array<{ fileName: string; messages: ExportedMessage[] }>
+  countInRange: (startMs: number, endMs: number) => Promise<number>
+  /** 只检查这个时间点之前的历史，默认现在 */
+  now?: number
+  /** 最多回溯多少天（默认 400 天，避免超长会话打太多请求） */
+  maxLookbackDays?: number
+  /**
+   * 进度回调。单次查询在大会话上可能要十几秒，全程无反馈会像卡死，
+   * 所以每完成一步都往外报一次。
+   */
+  onProgress?: (info: { done: number; total: number; label: string }) => void
+  /** 并发查询数，默认 4。太高会让 NapCat 侧排队更久，反而变慢。 */
+  concurrency?: number
+}): Promise<SyncPlan> {
+  const now = opts.now ?? Date.now()
+  const maxLookback = (opts.maxLookbackDays ?? 400) * 86_400_000
+  const concurrency = Math.max(1, opts.concurrency ?? 4)
+  const report = opts.onProgress ?? (() => {})
+
+  /** 有并发上限的批量执行，边完成边报进度。 */
+  const runPooled = async <T, R>(
+    items: T[],
+    label: (item: T) => string,
+    baseDone: number,
+    total: number,
+    fn: (item: T) => Promise<R>,
+  ): Promise<R[]> => {
+    const results = new Array<R>(items.length)
+    let next = 0
+    let done = 0
+    const workers = Array.from({ length: Math.min(concurrency, items.length) }, async () => {
+      while (true) {
+        const i = next++
+        if (i >= items.length) return
+        results[i] = await fn(items[i])
+        done++
+        report({ done: baseDone + done, total, label: label(items[i]) })
+      }
+    })
+    await Promise.all(workers)
+    return results
+  }
+
+  if (!opts.exported.length) {
+    return { gaps: [], scannedFiles: [], queryCount: 0, noJsonBaseline: true }
+  }
+
+  const { byDay, coveredUntil } = tallyExported(opts.exported)
+  const scannedFiles = opts.exported.map((f) => f.fileName)
+  let queryCount = 0
+
+  if (!byDay.size || coveredUntil === undefined) {
+    return { gaps: [], coveredUntil, scannedFiles, queryCount, noJsonBaseline: false }
+  }
+
+  // 已导出内容覆盖的月份集合（只在这些月份里找"变多了"的天；
+  // 完全没导出过的历史月份不属于"补同步"，属于用户自己没导，不在这里管）
+  const months = new Set<string>()
+  const earliestAllowed = now - maxLookback
+  for (const day of byDay.keys()) {
+    const [start] = dayRange(day)
+    if (start < earliestAllowed) continue
+    months.add(day.slice(0, 7))
+  }
+
+  const monthList = Array.from(months).sort()
+  // 总步数先按"月数"估，展开到天时再往上加
+  let totalSteps = monthList.length
+
+  // 第一层：按月粗查（并发）
+  const monthResults = await runPooled(
+    monthList,
+    (m) => `比对 ${m}`,
+    0,
+    totalSteps,
+    async (month) => {
+      const [ms, me] = monthRange(month)
+      const monthEnd = Math.min(me, now)
+      if (monthEnd <= ms) return { month, changed: false }
+      let exportedInMonth = 0
+      for (const [day, n] of byDay) {
+        if (day.startsWith(month)) exportedInMonth += n
+      }
+      const actualInMonth = await opts.countInRange(ms, monthEnd)
+      // 只关心"本地比导出多"。少的情况通常是导出时用了过滤条件，不该当成缺口。
+      return { month, changed: actualInMonth > exportedInMonth }
+    },
+  )
+  queryCount += monthList.length
+
+  // 第二层：只对有差异的月份展开到天（并发）
+  const suspectDays: string[] = []
+  for (const r of monthResults) {
+    if (!r.changed) continue
+    for (const day of daysInMonth(r.month, now)) {
+      if (dayRange(day)[0] < earliestAllowed) continue
+      suspectDays.push(day)
+    }
+  }
+  totalSteps += suspectDays.length
+
+  const dayResults = await runPooled(
+    suspectDays,
+    (d) => `细查 ${d}`,
+    monthList.length,
+    totalSteps,
+    async (day) => {
+      const [ds, de] = dayRange(day)
+      const exported = byDay.get(day) || 0
+      const actual = await opts.countInRange(ds, Math.min(de, now))
+      return { day, exported, actual }
+    },
+  )
+  queryCount += suspectDays.length
+
+  const gaps: DayGap[] = dayResults
+    .filter((r) => r.actual > r.exported)
+    .sort((a, b) => a.day.localeCompare(b.day))
+
+  return { gaps, coveredUntil, scannedFiles, queryCount, noJsonBaseline: false }
+}
+
+/** 把相邻的缺口日期合并成连续区间，减少导出任务数。 */
+export function mergeAdjacentDays(days: string[]): Array<{ start: string; end: string }> {
+  if (!days.length) return []
+  const sorted = [...days].sort()
+  const out: Array<{ start: string; end: string }> = []
+  let start = sorted[0]
+  let prev = sorted[0]
+  for (const day of sorted.slice(1)) {
+    const [prevStart] = dayRange(prev)
+    const [curStart] = dayRange(day)
+    if (curStart - prevStart <= 86_400_000) {
+      prev = day
+      continue
+    }
+    out.push({ start, end: prev })
+    start = day
+    prev = day
+  }
+  out.push({ start, end: prev })
+  return out
+}
